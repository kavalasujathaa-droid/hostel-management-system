# ==============================================================================
# HOSTEL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill with your actual production secrets.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# --- TiDB Cloud Starter Configuration ---
TIDB_HOST=your-tidb-cluster-host.gateway01.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your-cluster-username
TIDB_PASSWORD=your-cluster-password
TIDB_DATABASE=hostel_management

# --- Application Runtime ---
APP_NAME=Hostel Management System API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://your-domain.com","https://admin.your-domain.com"]

# --- Authentication & Cryptographic Keys ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-to-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Production Server & Reverse Proxy ---
PORT=8000
WEB_CONCURRENCY=2
LOG_LEVEL=info
DOMAIN=api.yourhosteldomain.com
ACME_EMAIL=admin@yourhosteldomain.com

# --- Optional Firebase Cloud Messaging (FCM) ---
# Path to service account JSON file for push notifications (if enabled)
FIREBASE_CREDENTIALS_PATH=
